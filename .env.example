# Runtime
NODE_ENV=development
APP_NAME=zoom-tg-bot
BOT_MODE=polling
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_WEBHOOK_URL=
ALLOWED_USERS=
BIND_HOST=127.0.0.1
PORT=8080
DATABASE_URL=./data/bot_state.sqlite3
TZ=Europe/Moscow

# Zoom Server-to-Server OAuth
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_HOST_USER_ID_OR_EMAIL=
ZOOM_AUTO_RECORDING=
ZOOM_WEBHOOK_SECRET_TOKEN=
ZOOM_WEBHOOK_PATH=/zoom/webhook

# Meeting defaults
QUICK_MEETING_DELAY_MINUTES=2
DEFAULT_SCHEDULED_TEMPLATE=call
DEFAULT_MEETING_DURATION_MINUTES=60
DEFAULT_QUICK_MEETING_TOPIC=Quick meeting
DEFAULT_SCHEDULED_MEETING_TOPIC=Scheduled meeting
TEMPLATE_QUICK_TOPIC=Quick meeting
TEMPLATE_QUICK_DURATION_MINUTES=60
TEMPLATE_LESSON_TOPIC=Lesson
TEMPLATE_LESSON_DURATION_MINUTES=60
TEMPLATE_CALL_TOPIC=Call
TEMPLATE_CALL_DURATION_MINUTES=60

# Runtime workers and retry policy
PENDING_ACTION_TTL_MINUTES=20
MAX_PENDING_ACTIONS=200
REMINDER_LEAD_MINUTES=15
FOLLOWUP_DELAY_MINUTES=5
HOUSEKEEPING_INTERVAL_SECONDS=60
LIST_LIMIT=10
RECURRING_DEFAULT_WEEKLY_OCCURRENCES=12
RECURRING_DEFAULT_MONTHLY_OCCURRENCES=6
ZOOM_REQUEST_RETRY_ATTEMPTS=3
ZOOM_RETRY_BACKOFF_SECONDS=1.5
ARTIFACT_POLL_INTERVAL_SECONDS=60
ARTIFACT_POLL_TIMEOUT_MINUTES=180

# Optional IMAP fallback for Zoom summary email
ZOOM_IMAP_HOST=
ZOOM_IMAP_PORT=993
ZOOM_IMAP_USERNAME=
ZOOM_IMAP_PASSWORD=
ZOOM_IMAP_FOLDER=INBOX
ZOOM_SUMMARY_EMAIL_FROM=no-reply@zoom.us

# Optional Git meeting-note export
GIT_NOTES_REPO_URL=
GIT_NOTES_BRANCH=main
GIT_NOTES_LOCAL_PATH=./data/meeting-notes
GIT_AUTHOR_NAME=Zoom Bot
GIT_AUTHOR_EMAIL=zoom-bot@local

# Meeting security
MEETING_WAITING_ROOM=false
MEETING_JOIN_BEFORE_HOST=true
MEETING_MUTE_UPON_ENTRY=false
MEETING_HOST_VIDEO=true
MEETING_PARTICIPANT_VIDEO=true
MEETING_USE_DEFAULT_PASSCODE=true
MEETING_PASSCODE=
